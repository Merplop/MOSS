################################################################
# doomgeneric — MOSS OS build
#
# Produces a statically-linked i386 ELF: "doom"
# Uses musl libc (libc.a + crt1.o) and the MOSS linker script
################################################################

CC      = i686-elf-gcc
AR      = i686-elf-ar
LD      = i686-elf-gcc

MUSL    = ../musl-out
USERLIBC_INC = ../userlibc/include
LDSCRIPT = ../userlibc/user.ld

CFLAGS  = -O2 -g -ffreestanding -nostdlib -Wall -Wextra \
           -I$(MUSL)/include -I$(USERLIBC_INC) -I. \
           -DNORMALUNIX -DLINUX \
           -DDOOMGENERIC_RESX=320 -DDOOMGENERIC_RESY=200 \
           -Wno-unused-parameter -Wno-pointer-sign \
           -Wno-sign-compare -Wno-missing-field-initializers \
           -std=gnu11

# Flags for MOSS syscall wrappers (need userlibc syscall.h first)
MOSS_CFLAGS = -O2 -g -ffreestanding -nostdlib -Wall \
              -I$(USERLIBC_INC) -I$(MUSL)/include -std=gnu11

LDFLAGS = -ffreestanding -nostdlib -T $(LDSCRIPT)

OBJDIR  = build
OUTPUT  = doom

# Core Doom engine objects (no platform-specific backends)
SRC_DOOM = dummy.o am_map.o doomdef.o doomstat.o dstrings.o \
           d_event.o d_items.o d_iwad.o d_loop.o d_main.o d_mode.o d_net.o \
           f_finale.o f_wipe.o g_game.o hu_lib.o hu_stuff.o \
           info.o i_cdmus.o i_endoom.o i_joystick.o i_scale.o \
           i_sound.o i_system.o i_timer.o \
           memio.o m_argv.o m_bbox.o m_cheat.o m_config.o m_controls.o \
           m_fixed.o m_menu.o m_misc.o m_random.o \
           p_ceilng.o p_doors.o p_enemy.o p_floor.o p_inter.o p_lights.o \
           p_map.o p_maputl.o p_mobj.o p_plats.o p_pspr.o p_saveg.o \
           p_setup.o p_sight.o p_spec.o p_switch.o p_telept.o \
           p_tick.o p_user.o \
           r_bsp.o r_data.o r_draw.o r_main.o r_plane.o r_segs.o \
           r_sky.o r_things.o \
           sha1.o sounds.o statdump.o st_lib.o st_stuff.o s_sound.o \
           tables.o v_video.o wi_stuff.o \
           w_checksum.o w_file.o w_main.o w_wad.o z_zone.o \
           w_file_stdc.o i_input.o i_video.o \
           doomgeneric.o doomgeneric_moss.o \
           mus2mid.o gusconf.o

# MOSS syscall wrapper objects
MOSS_OBJS = $(OBJDIR)/moss_stubs.o

OBJS = $(addprefix $(OBJDIR)/, $(SRC_DOOM)) $(MOSS_OBJS)

all: $(OUTPUT)

clean:
	rm -rf $(OBJDIR)
	rm -f $(OUTPUT)

$(OUTPUT): $(OBJS) $(MUSL)/lib/libc.a $(MUSL)/lib/crt1.o
	@echo "[Linking $@]"
	$(LD) $(LDFLAGS) -o $@ $(MUSL)/lib/crt1.o $(MUSL)/lib/crti.o $(OBJS) $(MUSL)/lib/libc.a $(MUSL)/lib/libm.a $(MUSL)/lib/crtn.o -lgcc

$(OBJS): | $(OBJDIR)

$(OBJDIR):
	mkdir -p $(OBJDIR)

$(OBJDIR)/%.o: %.c
	@echo "[Compiling $<]"
	$(CC) $(CFLAGS) -c $< -o $@

# MOSS syscall wrapper compile rules
$(OBJDIR)/moss_stubs.o: moss_stubs.c
	@echo "[Compiling MOSS $<]"
	$(CC) $(MOSS_CFLAGS) -c $< -o $@

.PHONY: all clean
