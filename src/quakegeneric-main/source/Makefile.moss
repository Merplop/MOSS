################################################################
# quakegeneric — MOSS OS build
#
# Produces a statically-linked i386 ELF: "quake"
# Uses musl libc (libc.a + crt1.o) and the MOSS linker script
################################################################

CC      = i686-elf-gcc
AR      = i686-elf-ar
LD      = i686-elf-gcc

MUSL    = ../../musl-out
USERLIBC_INC = ../../userlibc/include
LDSCRIPT = ../../userlibc/user.ld

CFLAGS  = -O2 -g -ffreestanding -nostdlib -Wall \
           -I$(MUSL)/include -I$(USERLIBC_INC) -I. \
           -m32 -std=gnu99 \
           -Wno-unused-parameter -Wno-pointer-sign \
           -Wno-sign-compare -Wno-missing-field-initializers \
           -Wno-unused-variable -Wno-unused-but-set-variable

# Flags for MOSS syscall wrappers (need userlibc syscall.h first)
MOSS_CFLAGS = -O2 -g -ffreestanding -nostdlib -Wall -m32 \
              -I$(USERLIBC_INC) -I$(MUSL)/include -std=gnu99

LDFLAGS = -ffreestanding -nostdlib -m32 -T $(LDSCRIPT)

OBJDIR  = build_moss
OUTPUT  = quake

OBJS = \
	$(OBJDIR)/cd_null.o $(OBJDIR)/chase.o $(OBJDIR)/cl_demo.o \
	$(OBJDIR)/cl_input.o $(OBJDIR)/cl_main.o $(OBJDIR)/cl_parse.o \
	$(OBJDIR)/cl_tent.o $(OBJDIR)/cmd.o $(OBJDIR)/common.o \
	$(OBJDIR)/console.o $(OBJDIR)/crc.o $(OBJDIR)/cvar.o \
	$(OBJDIR)/d_edge.o $(OBJDIR)/d_fill.o $(OBJDIR)/d_init.o \
	$(OBJDIR)/d_modech.o $(OBJDIR)/d_part.o $(OBJDIR)/d_polyse.o \
	$(OBJDIR)/d_scan.o $(OBJDIR)/d_sky.o $(OBJDIR)/d_sprite.o \
	$(OBJDIR)/d_surf.o $(OBJDIR)/d_vars.o $(OBJDIR)/d_zpoint.o \
	$(OBJDIR)/draw.o $(OBJDIR)/host_cmd.o $(OBJDIR)/host.o \
	$(OBJDIR)/in_null.o $(OBJDIR)/keys.o $(OBJDIR)/mathlib.o \
	$(OBJDIR)/menu.o $(OBJDIR)/model.o \
	$(OBJDIR)/net_loop.o $(OBJDIR)/net_main.o $(OBJDIR)/net_none.o \
	$(OBJDIR)/net_vcr.o $(OBJDIR)/nonintel.o \
	$(OBJDIR)/pr_cmds.o $(OBJDIR)/pr_edict.o $(OBJDIR)/pr_exec.o \
	$(OBJDIR)/r_aclip.o $(OBJDIR)/r_alias.o $(OBJDIR)/r_bsp.o \
	$(OBJDIR)/r_draw.o $(OBJDIR)/r_edge.o $(OBJDIR)/r_efrag.o \
	$(OBJDIR)/r_light.o $(OBJDIR)/r_main.o $(OBJDIR)/r_misc.o \
	$(OBJDIR)/r_part.o $(OBJDIR)/r_sky.o $(OBJDIR)/r_sprite.o \
	$(OBJDIR)/r_surf.o $(OBJDIR)/r_vars.o \
	$(OBJDIR)/sbar.o $(OBJDIR)/screen.o $(OBJDIR)/snd_null.o \
	$(OBJDIR)/sv_main.o $(OBJDIR)/sv_move.o $(OBJDIR)/sv_phys.o \
	$(OBJDIR)/sv_user.o $(OBJDIR)/sys_null.o $(OBJDIR)/vid_null.o \
	$(OBJDIR)/view.o $(OBJDIR)/wad.o $(OBJDIR)/world.o \
	$(OBJDIR)/zone.o $(OBJDIR)/quakegeneric.o \
	$(OBJDIR)/quakegeneric_moss.o \
	$(OBJDIR)/moss_stubs.o

all: $(OUTPUT)

clean:
	rm -rf $(OBJDIR)
	rm -f $(OUTPUT)

$(OUTPUT): $(OBJS) $(MUSL)/lib/libc.a $(MUSL)/lib/crt1.o
	@echo "[Linking $@]"
	$(LD) $(LDFLAGS) -o $@ $(MUSL)/lib/crt1.o $(MUSL)/lib/crti.o $(OBJS) $(MUSL)/lib/libc.a $(MUSL)/lib/libm.a $(MUSL)/lib/crtn.o -lgcc

$(OBJS): | $(OBJDIR)

$(OBJDIR):
	mkdir -p $(OBJDIR)

$(OBJDIR)/%.o: %.c
	@echo "[Compiling $<]"
	$(CC) $(CFLAGS) -c $< -o $@

# MOSS syscall wrapper compile rule
$(OBJDIR)/moss_stubs.o: moss_stubs.c
	@echo "[Compiling MOSS $<]"
	$(CC) $(MOSS_CFLAGS) -c $< -o $@

.PHONY: all clean
